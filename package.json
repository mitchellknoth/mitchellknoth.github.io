{
  "name": "mitch-portfolio",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:visual": "playwright test",
    "test:visual:headed": "playwright test --headed",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "corpus": "node scripts/corpus/build.mjs",
    "quality": "npm run lint:design && npm run check && npm run build && npm run test:build && npm run test:visual",
    "lint:design": "designmd lint DESIGN.md",
    "preview:workers": "wrangler dev --ip 127.0.0.1 --port 8787 --show-interactive-dev-session=false",
    "deploy:workers": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/mdx": "5.0.4",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.2.4",
    "astro": "6.1.9",
    "remark-smartypants": "^3.0.2",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.62.1",
    "parse5": "7.3.0",
    "wrangler": "4.158.0"
  }
}
