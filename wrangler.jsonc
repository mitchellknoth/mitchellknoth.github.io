{
	"$schema": "node_modules/wrangler/config-schema.json",
	// #13: the pre-rendered site is served from Workers static assets. Static pages never run Worker code;
	// only /agent/* reaches worker/index.ts first (M2 spike).
	"name": "mitchellknoth-com",
	"main": "worker/index.ts",
	// Pinned; change it deliberately and re-run the Workers parity test when you do.
	"compatibility_date": "2026-11-05",
	// Required by the Agents SDK and Pi packages.
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Matches the site's directory-style URLs: /about redirects to /about/, which serves about/index.html.
		"html_handling": "auto-trailing-slash",
		// Serve dist/404.html with a 404 status for unknown paths, as GitHub Pages does.
		"not_found_handling": "404-page",
		// Only the agent API runs Worker code before assets are considered.
		"run_worker_first": ["/agent", "/agent/*"]
	},
	// The binding allowlist (#13): Durable Objects, Workers AI, and the static assets above. Nothing else.
	// tests/build/agent-contract.test.mjs fails the build if another binding type appears.
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "GUARD", "class_name": "Guard" },
			{ "name": "VISITOR_SESSION", "class_name": "VisitorSession" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Guard", "VisitorSession"] }],
	"vars": {
		// Kill switch. The agent answers only when this is "true"; the static site never depends on it. The homepage
		// island reads this same value at build time (src/lib/agent/enabled.ts): while it is "false" the island shows
		// its switched-off notice and makes no /agent request, so visitors never meet the edge's human check for it.
		"AGENT_ENABLED": "false",
		// The answering model (System Two). GPT-6 Luna runs through the AI binding and the gateway below. The Clef
		// intent check (#30) is the separate System One gate in front of it. The eval scorecard (#17) can change this.
		"AGENT_MODEL": "openai/gpt-6-luna",
		// Reasoning effort for the model: off, minimal, low, medium, high, xhigh or max. Higher effort bills more
		// output tokens per question; the live check (#16) records the real cost. The gateway spend limit still caps it.
		"AGENT_REASONING": "max",
		// The intent check in front of the agent (worker/intent.ts): "off", "shadow" (log the verdict, never refuse) or
		// "enforce". The eval config inherits it, so scored runs measure the check together with the agent.
		"INTENT_MODE": "enforce",
		// The AI Gateway that carries the inference spend limit.
		"AI_GATEWAY_ID": "mitchellknoth-com-agent",
		"MAX_PROMPT_CHARS": "1000",
		"MAX_MESSAGES_PER_SESSION": "20",
		"DAILY_AGENT_REQUESTS": "500",
		// Retention: a session object is deleted this long after its first question, and the session cookie
		// expires after the same time. See docs/runbooks/agent-retention.md.
		"SESSION_TTL_SECONDS": "86400"
	},
	// The custom domain is attached once in the Cloudflare dashboard (docs/runbooks/workers-cutover.md),
	// so the CI deploy token needs no zone or DNS permissions and this file declares no routes.
	"workers_dev": true,
	"preview_urls": false
}
