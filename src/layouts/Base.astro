---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { site, nav } from '../config';
import ThemeToggle from '../components/site/ThemeToggle';
import { brandClass, footerLinkProps, navProps } from '../lib/site-ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : site.title;
const pageDesc = description ?? site.description;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL('/social-card.png', Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0a08" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={socialImageUrl} />

    {/* No `preload`: Astro's local font provider can't filter preloads by subset, so preloading would also
        fetch every latin-ext file (~130 KB) that these pages never use. The size-adjusted fallbacks
        (optimizedFallbacks in astro.config.mjs) are what keep the swap from re-wrapping the hero. */}
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-instrument-serif" />
    <Font cssVariable="--font-jetbrains-mono" />

    <script is:inline>
      // The visitor's theme crosses a client-side navigation: the incoming document starts as the default.
      document.addEventListener('astro:before-swap', function (event) {
        var theme = document.documentElement.dataset.theme || 'dark';
        event.newDocument.documentElement.dataset.theme = theme;
        var meta = event.newDocument.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#fbf8f1' : '#0c0a08');
      });
    </script>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
          const m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', theme === 'light' ? '#fbf8f1' : '#0c0a08');
        } catch (_) {}
      })();
    </script>

    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="site-shell mx-auto flex min-h-dvh flex-col">
      <header
        class="site-header flex items-center justify-between border-b py-4 sm:py-5"
        style="border-color: var(--border);"
      >
        <a href="/" data-slot="button" data-site="brand" class={`${brandClass} shrink-0`} aria-label="Home">
          {site.name}
        </a>
        <div class="site-header__actions flex items-center gap-3 sm:gap-4">
          <nav aria-label="Primary" class="flex items-center sm:gap-1">
            {
              nav.map((item) => {
                const active = currentPath === item.href || currentPath.startsWith(item.href);
                return (
                  <a href={item.href} {...navProps} aria-current={active ? 'page' : undefined}>
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
          <ThemeToggle client:load />
        </div>
      </header>

      <main id="main-content" class="flex-1 py-10 sm:py-14">
        <slot />
      </main>

      <footer
        class="flex flex-wrap items-center justify-between gap-3 border-t py-5 text-[12px]"
        style="border-color: var(--border); color: var(--fg-dim); font-family: var(--font-mono);"
      >
        <span>{site.location}</span>
        <span class="-mx-3 flex flex-wrap">
          <a href={site.github} target="_blank" rel="noreferrer" {...footerLinkProps}>github</a>
          <a href={site.linkedin} target="_blank" rel="noreferrer" {...footerLinkProps}>linkedin</a>
          <a href={`mailto:${site.email}`} {...footerLinkProps}>email</a>
          <a href="/rss.xml" {...footerLinkProps}>rss</a>
        </span>
      </footer>
    </div>
  </body>
</html>
