---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { linkClass, tagClass } from '../../lib/site-ui';
import { bindDash } from '../../lib/typography';
import { Badge } from '../../components/ui/badge';
import { Card, CardContent } from '../../components/ui/card';
import { cardLinkClass, stretchedLinkClass } from '../../lib/site-ui';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, previous: projects[index - 1], next: projects[index + 1] },
  }));
}

const { project, previous, next } = Astro.props as {
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
};
const { Content } = await render(project);

// The facts restate the case's own text; a case that states no evidence limit has three, not four.
const facts = project.data.facts;
const factRows = facts
  ? [
      ['Context', facts.context],
      ['Contribution', facts.contribution],
      ['Result', facts.result],
      ...(facts.boundary ? [['Evidence boundary', facts.boundary]] : []),
    ]
  : [];
// Neighbours in the order the Work page lists the cases; the first has no previous, the last no next.
const neighbours = [
  previous && { label: 'Previous case', project: previous },
  next && { label: 'Next case', project: next },
].filter((item): item is { label: string; project: CollectionEntry<'projects'> } => Boolean(item));
---

<Base title={project.data.title} description={project.data.summary} ogType="article">
  <article class="content mx-auto">
    <a href="/work/" data-slot="button" data-site="link" class={`${linkClass} eyebrow-link`} data-corpus-ignore>← all work</a>

    <header class="mb-10 mt-5">
      <div class="mono-meta mb-4">{bindDash(project.data.period)}</div>
      <h1 class="work-title prose-serif" style="color: var(--fg);">
        {bindDash(project.data.title)}
      </h1>
      <p class="mt-4 text-[17px] leading-[1.7]" style="color: var(--fg-muted);">
        {project.data.summary}
      </p>

      {
        project.data.stack.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2" data-corpus-items>
            {project.data.stack.map((item) => (
              <Badge variant="outline" className={tagClass}>{item}</Badge>
            ))}
          </div>
        )
      }

      {
        project.data.href && (
          <p class="mt-6 text-[12px]" style="font-family: var(--font-mono);" data-corpus-ignore>
            <a href={project.data.href} target="_blank" rel="noreferrer" style="color: var(--accent);">
              Visit project ↗
            </a>
          </p>
        )
      }

      {
        factRows.length > 0 && (
          <Card className="case-facts mt-8" role="group" aria-label="Case at a glance" data-corpus-ignore>
            <CardContent>
              <dl class="case-facts__grid">
                {factRows.map(([label, value]) => (
                  <div data-fact={label.toLowerCase().replace(' ', '-')}>
                    <dt class="mono-meta">{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </CardContent>
          </Card>
        )
      }
    </header>

    <Content />

    {
      neighbours.length > 0 && (
        <nav class="case-neighbours" aria-label="More case studies" data-corpus-ignore>
          {neighbours.map(({ label, project: other }) => (
            <Card size="sm" className={`case-neighbour ${cardLinkClass}`} data-direction={label === 'Next case' ? 'next' : 'previous'}>
              <CardContent className="case-neighbour__body">
                <span class="mono-meta">{label} · {bindDash(other.data.period)}</span>
                <span class="prose-serif case-neighbour__title">
                  <a href={`/work/${other.id}/`} data-slot="button" data-site="link" class={stretchedLinkClass}>{bindDash(other.data.title)}</a>
                </span>
              </CardContent>
            </Card>
          ))}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .case-facts__grid {
    display: grid;
    gap: 1.25rem 2rem;
    margin: 0;
  }
  .case-facts__grid dt {
    margin-bottom: 0.3rem;
  }
  .case-facts__grid dd {
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    overflow-wrap: anywhere;
  }
  @media (min-width: 640px) {
    .case-facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-neighbours {
    display: grid;
    gap: 1rem;
    margin-top: 3.5rem;
  }
  .case-neighbour__body {
    display: grid;
    gap: 0.4rem;
  }
  .case-neighbour__title {
    font-size: 1.375rem;
    line-height: 1.25;
  }
  /* A card title, not an inline prose link: the heading colour, no rule under it until hover (the prose link
     rule in global.css would draw an amber hairline across the whole stretched link). */
  .case-neighbour__title a {
    border-bottom: 0;
    color: var(--fg);
  }
  @media (min-width: 640px) {
    .case-neighbours {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* A lone "next" (the first case) keeps its place on the right, as the pair does. */
    .case-neighbour[data-direction='next']:only-child {
      grid-column: 2;
    }
  }
</style>
