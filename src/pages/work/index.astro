---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const recent = projects.filter((p) => p.data.section === 'recent');
const foundations = projects.filter((p) => p.data.section === 'foundations');

// Two columns leave a lone card when the compact count is odd; that last card spans both and uses the lead's
// two-column layout instead of sitting beside an empty cell. `lead` is the number of featured cards before the grid.
const oddLast = (list: unknown[], index: number, lead = 1) => index === list.length - 1 && (list.length - lead) % 2 === 1 && list.length - lead > 1;

const recentLede =
  'Production software, cloud execution, and developer-platform reliability.';
const foundationsLede =
  'The platform work this chapter builds on: cloud networking, secure data access, and the operational plumbing that lets other teams move fast.';
---

<Base
  title="Work"
  description="Recent delivery across the AI-era SDLC and developer experience, built on earlier cloud and platform engineering at John Deere."
>
  <section class="mb-2">
    <h1 class="type-h1 mb-4" style="color: var(--fg);">Work</h1>
    <p
      class="max-w-[60ch] text-[15.5px] leading-[1.7] text-pretty"
      style="color: var(--fg-muted);"
    >
      Engineering problems, implementation decisions, and delivered results. Recent work from
      October 2025 through October 2026, followed by earlier cloud and platform foundations.
    </p>
  </section>

  <SectionLabel label="Recent work" />
  <p class="mb-6 max-w-[60ch] text-[15px] leading-[1.65] text-pretty" style="color: var(--fg-muted);">
    {recentLede}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    {
      recent.map((p, i) => (
        <div class={i === 0 || oddLast(recent, i) ? 'md:col-span-2' : ''}>
          <WorkCard project={p} lead={i === 0} wide={oddLast(recent, i)} />
        </div>
      ))
    }
  </div>

  <SectionLabel label="Platform & Cloud Foundations" />
  <p class="mb-6 max-w-[60ch] text-[15px] leading-[1.65] text-pretty" style="color: var(--fg-muted);">
    {foundationsLede}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    {
      foundations.map((project, i) => (
        <div class={oddLast(foundations, i, 0) ? 'md:col-span-2' : ''}>
          <WorkCard project={project} wide={oddLast(foundations, i, 0)} />
        </div>
      ))
    }
  </div>
</Base>
