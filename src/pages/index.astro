---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MetricCard from '../components/MetricCard.astro';
import { site } from '../config';
import AgentChat from '../components/agent/AgentChat';
import FeaturedPost from '../components/writing/FeaturedPost.astro';
import { getProjects, getPublishedPosts, splitFeaturedPost } from '../lib/content';

const { featured } = splitFeaturedPost(await getPublishedPosts());

const featuredMetrics = (await getProjects())
  .filter((project) => project.data.featured && project.data.metric)
  .slice(0, 3);
---

<Base>
  <section class="home-hero">
    <div class="hero-intro">
      <h1
        class="prose-serif mb-6 text-[34px] leading-[1.1] sm:text-[44px]"
        style="color: var(--fg);"
      >
        Not whether agents can write code, <em style="color: var(--accent);">but whether teams can ship it.</em>
      </h1>

      <div class="hero-detail">
        <div class="hero-copy">
          <p class="max-w-[60ch] text-[16.5px] leading-[1.7] text-pretty" style="color: var(--fg-muted);">
            I’m Mitch, a Cloud Software Engineer at John Deere whose sole focus is DevAI and making Frontier
            Teams move faster without lowering the bar.
          </p>
          <p class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-[14px]" style="color: var(--accent);">
            <a href="/work/" class="standalone-link underline underline-offset-4">Explore my work →</a>
            <a href="/resume/" class="standalone-link underline underline-offset-4">Résumé →</a>
            <a href={`mailto:${site.email}`} class="standalone-link underline underline-offset-4">Contact →</a>
          </p>
        </div>
      </div>
    </div>
    {/*
      The agent island (#18). The intro above is the page; the island is an addition to it.
      client:idle keeps React off the critical path. The server-rendered "loading" shell reserves
      its space. Without JavaScript it is hidden and the hero is one column, so the static intro
      stands alone; on a host with no agent (GitHub Pages) the island removes itself the same way.
    */}
    <noscript><style is:inline>[data-agent-island] { display: none !important; } .home-hero { grid-template-columns: minmax(0, 1fr) !important; }</style></noscript>
    <AgentChat client:idle />
  </section>

  <SectionLabel label="Selected work" href="/work/" />
  <p
    class="mb-5 -mt-3 text-[15px] italic"
    style="color: var(--fg-muted); font-family: var(--font-serif);"
  >
    What I delivered, the decisions behind it, and what you can inspect.
  </p>
  <div
    class="grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border md:grid-cols-3"
    style="background: var(--border); border-color: var(--border);"
  >
    {
      featuredMetrics.map((project) => (
        <MetricCard
          href={`/work/${project.id}/`}
          value={project.data.metric!.value}
          label={project.data.metric!.label}
        />
      ))
    }
  </div>

  <section class="decision-note" aria-labelledby="decision-question">
    <div>
      <p class="decision-intro">Team Brain</p>
      <h2 id="decision-question">An agent can only use the context it can reach.</h2>
    </div>
    <div class="decision-reasoning">
      <p>Most of what a team knows lives in people’s heads, chat threads, and one engineer’s
        prompt collection. Team Brain is a shared repository where research and decisions are
        written down once, kept current with help from agents, and searchable by any engineer
        or agent tool.</p>
      <p class="decision-evidence">In use by my team. Adoption and productivity effects are still being measured.</p>
      <a class="standalone-link" href="/work/team-brain/">Read the case study →</a>
    </div>
  </section>

  {/* Selected Work intentionally remains above Writing. */}
  {
    !featured ? (
      <>
        <SectionLabel label="Writing" />
        <p
          class="-mt-3 max-w-[60ch] text-[15px] leading-[1.7]"
          style="color: var(--fg-muted);"
        >
          Empirical notes on agentic delivery, starting with how to measure it.
          <a href="/writing/" style="color: var(--accent); text-decoration: underline; text-underline-offset: 2px;"> First essays landing soon →</a>
        </p>
      </>
    ) : (
      <>
        <SectionLabel label="Writing" />
        <FeaturedPost post={featured} />
        <div class="mt-4 text-right">
          <a
            href="/writing/"
            class="standalone-link text-[13px] underline underline-offset-4"
            style="color: var(--accent); font-family: var(--font-mono);"
          >
            All writing →
          </a>
        </div>
      </>
    )
  }
</Base>
<style>
  .decision-note {
    max-width: 66rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 1rem;
  }
  .decision-intro {
    margin-bottom: 0.75rem;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .decision-note h2 {
    max-width: 22ch;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    line-height: 1.2;
    color: var(--fg);
  }
  .decision-reasoning { max-width: 55ch; font-size: 17px; line-height: 1.7; }
  .decision-evidence { margin-top: 1rem; color: var(--fg-muted); }
  .decision-reasoning a {
    margin-top: 0.75rem;
    color: var(--accent);
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .decision-note { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 2rem; }
  }
  .hero-copy { font-size: 16.5px; }
  .home-hero {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    /* The readable lead beside the agent. The agent gets the wider column because the agreed plan
       (#13) makes it the page's primary experience; DESIGN.md's Home recipe allows a 7/5 hero, and
       this deliberately flips it (flagged for review in #18). Both columns hold content. */
    .home-hero:has([data-agent-island]) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: 3rem;
    }
  }
</style>
