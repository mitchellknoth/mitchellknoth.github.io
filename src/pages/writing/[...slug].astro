---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPostDate, getPublishedPosts } from '../../lib/content';
import { linkClass } from '../../lib/site-ui';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = formatPostDate(post.data.date);
// The kicker may wrap on a phone. Each part keeps the separator that follows it, so a line never opens with "·".
// The text content is unchanged (same words, same spaces), only grouped.
const eyebrowParts = (post.data.eyebrow ?? 'Essay').split(' · ');
---

<Base title={post.data.title} description={post.data.summary} ogType="article">
  <article class="article-layout content mx-auto">
    <header class="article-header mb-10">
      <div class="article-eyebrow mono-meta mb-5">
        {eyebrowParts.map((part, index) => (
          <Fragment>
            <span class="article-eyebrow__part">{index < eyebrowParts.length - 1 ? `${part} ·` : part}</span>
            {index < eyebrowParts.length - 1 && ' '}
          </Fragment>
        ))}
      </div>
      <h1 class="prose-serif" style="color: var(--fg);">
        {post.data.title}
      </h1>
      <p class="mt-4 text-[17px] leading-[1.7]" style="color: var(--fg-muted);">
        {post.data.summary}
      </p>
      <div class="mono-meta mt-5">
        <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
        {post.data.readingTime ? ` · ${post.data.readingTime}` : ''}
      </div>
    </header>

    <Content />

    <hr />
    <p data-corpus-ignore>
      <a href="/writing/" data-slot="button" data-site="link" class={`${linkClass} eyebrow-link`}>← all writing</a>
    </p>
  </article>
</Base>
