---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import FeaturedPost from '../../components/writing/FeaturedPost.astro';
import { getPublishedPosts, splitFeaturedPost } from '../../lib/content';

const posts = await getPublishedPosts();
const { featured, archive } = splitFeaturedPost(posts);

// The archive is two columns from 640px and three from 1280px, so a count that doesn't divide leaves a lone card
// beside an empty cell. Run the grid on six tracks instead: a card is two wide (three across), or three wide
// (two across), and the leftover last card(s) take the whole row (or share it) so no cell is empty.
const lastCard = (index: number) => {
  const count = archive.length;
  const classes: string[] = ['sm:col-span-3', 'xl:col-span-2'];
  if (index === count - 1 && count % 2 === 1) classes[0] = 'sm:col-span-6';
  if (count % 3 === 1 && index === count - 1) classes[1] = 'xl:col-span-6';
  if (count % 3 === 2 && index >= count - 2) classes[1] = 'xl:col-span-3';
  return classes.join(' ');
};
---

<Base title="Writing" description="Notes on AI-native development, cloud networking, and enterprise platform engineering.">
  <section class="mb-12">
    <h1 class="type-h1 mb-4" style="color: var(--fg);">Writing</h1>
    <p class="max-w-[60ch] text-[15.5px] leading-[1.7]" style="color: var(--fg-muted);">
      Published notes on AI-native development, cloud networking, and enterprise platform engineering.
    </p>
  </section>

  <div>
    {
      !featured ? (
        <p class="text-[14px]" style="color: var(--fg-dim);">
          Nothing published yet.
        </p>
      ) : (
        <>
          <FeaturedPost post={featured} />
          {archive.length > 0 && (
            <section aria-labelledby="writing-archive-title">
              <SectionLabel label="More writing" id="writing-archive-title" />
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
                {archive.map((post, index) => (
                  <PostCard
                    className={lastCard(index)}
                    href={`/writing/${post.id}/`}
                    date={post.data.date}
                    title={post.data.title}
                    summary={post.data.summary}
                    readingTime={post.data.readingTime}
                  />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </div>
</Base>
