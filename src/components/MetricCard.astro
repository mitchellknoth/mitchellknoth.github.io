---
import { Card, CardContent, CardHeader } from './ui/card';
import { cardLinkClass, stretchedLinkClass } from '../lib/site-ui';

interface Props {
  href: string;
  value: string;
  label: string;
}
const { href, value, label } = Astro.props;
---

<Card className={cardLinkClass}>
  <CardHeader>
    <h3 class="type-h3">
      <a href={href} data-slot="button" data-site="link" class={`${stretchedLinkClass} text-primary`}>{value}<span aria-hidden="true" class="ml-1.5 font-sans text-[0.65em]">→</span></a>
    </h3>
  </CardHeader>
  <CardContent className="text-[14px] leading-[1.55] text-muted-foreground">{label}</CardContent>
</Card>
