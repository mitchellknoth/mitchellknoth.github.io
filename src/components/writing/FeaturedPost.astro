---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../../lib/content';
import { linkClass, titleLinkClass } from '../../lib/site-ui';
import { Card, CardContent, CardHeader } from '../ui/card';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const href = `/writing/${post.id}/`;
const dateLabel = formatPostDate(post.data.date);
---

<Card className="featured-post">
  <CardHeader className="featured-post__head">
    <div class="mono-meta">Featured writing · {dateLabel}</div>
    <h2 class="prose-serif">
      <a class={titleLinkClass} href={href}>{post.data.title}</a>
    </h2>
  </CardHeader>
  <CardContent className="featured-post__body">
    <p>{post.data.summary}</p>
    <a class:list={[linkClass, 'featured-post__link']} data-slot="button" data-site="link" href={href}>
      Read the piece →
    </a>
  </CardContent>
</Card>

<style>
  /* Card supplies the surface (6px, flat, border); the featured essay keeps the stronger editorial border, the
     site's one raised surface. */
  .featured-post {
    border-color: var(--editorial-border);
    padding-block: clamp(1.4rem, 3vw, 2.5rem);
  }

  .featured-post__head {
    gap: 0.65rem;
  }

  .featured-post h2 {
    color: var(--fg);
    font-size: clamp(1.55rem, 5vw, 2rem);
    line-height: 1.15;
    margin: 0;
  }

  .featured-post h2 a {
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-post h2 a:hover {
      color: var(--accent);
    }
  }

  .featured-post__body p {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 0.5rem;
    max-width: 60ch;
  }

  @media (min-width: 900px) {
    .featured-post {
      align-items: start;
      column-gap: clamp(2rem, 5vw, 4.5rem);
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      padding-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    }

    .featured-post__link {
      justify-self: start;
    }
  }
</style>
