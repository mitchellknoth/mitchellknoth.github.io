---
import { Card, CardContent, CardHeader } from '../ui/card';
import { cardLinkClass, stretchedLinkClass } from '../../lib/site-ui';

interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<Card className={`editorial-reading related-work ${cardLinkClass}`} role="complementary" aria-labelledby="related-work-title" data-corpus-ignore>
  <CardHeader>
    <div class="mono-meta">Related work</div>
    <h2 id="related-work-title"><a href={href} data-slot="button" data-site="link" class={stretchedLinkClass}>{title}</a></h2>
  </CardHeader>
  <CardContent><p>{description}</p></CardContent>
</Card>

<style is:global>
  .related-work {
    margin-top: 2.5rem;
  }

  .related-work h2 {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0.4rem 0 0;
  }

  .related-work h2 a {
    border-bottom: 0;
    color: var(--accent);
  }

  .related-work p {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin: 0;
  }
</style>
