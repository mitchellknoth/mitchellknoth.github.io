---
import { Card } from '../ui/card';
---
<Card className="editorial-reading framework-panel" role="complementary" aria-labelledby="framework-panel-title">
  <div class="mono-meta">Practical lens</div>
  <h2 id="framework-panel-title">
    <span>Agent</span>
    <span aria-hidden="true" class="operator">=</span>
    <span class="sr-only">equals</span>
    <span>Model</span>
    <span aria-hidden="true" class="operator">+</span>
    <span class="sr-only">plus</span>
    <span>Harness</span>
  </h2>
  <p>Capability meets context, controls, feedback, and durable learning.</p>
</Card>

<style is:global>
  .framework-panel {
    border-color: var(--editorial-border);
    margin: 2.25rem 0;
    padding-inline: 1.25rem;
    text-align: center;
  }

  .framework-panel .mono-meta {
    text-align: left;
  }

  .framework-panel h2 {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-serif);
    font-size: var(--h2-size);
    font-weight: 400;
    gap: 0.2em;
    justify-content: center;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 1rem 0 0.5rem;
  }

  .framework-panel .operator {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65em;
  }

  .framework-panel p {
    color: var(--fg-muted);
    margin: 0;
  }
</style>
