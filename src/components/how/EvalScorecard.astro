---
// INTEGRATION POINT — eval scorecard history (#17 evals, #18).
//
// The eval harness (scripts/evals/, merged in #22; format in evals/README.md, "Scorecards") commits each
// scored run as `evals/results/<YYYY-MM-DD>/<model-slug>.json` (`schemaVersion: 1`) with a `.md` summary
// beside it. No run is committed yet, so this component renders an honest empty state and nothing else:
// no example rows, no placeholder numbers.
//
// To wire it once the first run is committed:
//   1. Read the runs at build time, e.g.
//        const runs = Object.values(import.meta.glob('/evals/results/*/*.json', { eager: true, import: 'default' }));
//      `npm run test:build` already checks every committed scorecard with `validateRun` from
//      scripts/evals/results.mjs; reuse it here so a malformed run fails the build.
//   2. Pass them in as `runs`, newest first, and render one row per run: date, model, question-set
//      version, `summary.passRate` and the per-check counts exactly as recorded. Link each run to its
//      committed .json on GitHub so every figure is inspectable.
//   3. Replace the "no figures" check in tests/how-this-works.spec.ts with one that the rows match the
//      committed files.
interface Props {
  /** Scored runs from evals/results/. Empty until the first run is committed. */
  runs?: readonly unknown[];
}

const { runs = [] } = Astro.props;
---

<section class="eval-scorecard" aria-labelledby="scorecard-title" data-eval-scorecard data-runs={runs.length}>
  <h2 id="scorecard-title">Scorecard</h2>
  {
    runs.length === 0 && (
      <p>
        No scored runs are published yet. Each run will appear here with its date, the model it tested and the
        result of each check, linked to the results file it came from.
      </p>
    )
  }
</section>
