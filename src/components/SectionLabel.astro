---
import { Separator } from '../components/ui/separator';
import { linkClass } from '../lib/site-ui';

interface Props {
  label: string;
  href?: string;
  /** Visible link text; defaults to "View all →". */
  linkText?: string;
  /** An id for the heading, for an aria-labelledby on the section it heads. */
  id?: string;
}
const { label, href, linkText = 'View all →', id } = Astro.props;
---

<div class="mb-6 mt-14 flex items-center gap-4">
  <h2 id={id} class="section-label__heading type-h2 shrink-0">{label}</h2>
  <Separator className="flex-1" />
  {
    href && (
      <a href={href} aria-label={`View all ${label.toLowerCase()}`} data-slot="button" data-site="link" class={`${linkClass} shrink-0`}>
        {linkText}
      </a>
    )
  }
</div>

<style>
  .section-label__heading {
    color: var(--fg);
    margin: 0;
  }
</style>
