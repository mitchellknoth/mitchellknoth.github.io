{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [
      "./worker-configuration.d.ts",
      "node"
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "test",
    "vitest.config.ts"
  ]
}
